// =====================================================================
// measures.dax · every DAX measure in MusicSales.pbix (Team DIM Data)
// One line per measure: Home > New measure, paste, Enter. Values are
// with no filters. Play and salary figures come from SIMULATED data.
// =====================================================================

// ---- Music Sales (home table FACT_SALE) ----
// Expected: 2,328.60
Total Sales = SUM ( FACT_SALE[SALEAMOUNT] )

// Expected: 2,240
Units Sold = SUM ( FACT_SALE[QUANTITY] )

// Expected: 1.04  (unit price is non-additive, so it is averaged, not summed)
Average Unit Price = AVERAGE ( FACT_SALE[UNITPRICE] )

// Expected: 412
Invoice Count = DISTINCTCOUNT ( FACT_SALE[INVOICEID] )

// Expected: 59
Customers With Sales = DISTINCTCOUNT ( FACT_SALE[CUSTOMERKEY] )

// Expected: $5.65 (dashboard)
Average Invoice Value = DIVIDE ( [Total Sales], [Invoice Count] )

// ---- Track Playtime (home table FACT_TRACK_PLAYTIME) ----
// Expected: 2,000
Play Count = SUM ( FACT_TRACK_PLAYTIME[PLAYCOUNT] )

// Expected: 934,348
Total Seconds Played = SUM ( FACT_TRACK_PLAYTIME[SECONDSPLAYED] )

// Expected: 259.54
Total Hours Played = DIVIDE ( [Total Seconds Played], 3600 )

// Expected: 467.17
Average Seconds per Play = DIVIDE ( [Total Seconds Played], [Play Count] )

// Expected: 0.81 (format as a percentage: 81.2%)
Completion Rate = DIVIDE ( SUM ( FACT_TRACK_PLAYTIME[SECONDSPLAYED] ), SUM ( FACT_TRACK_PLAYTIME[TRACKDURATIONSECONDS] ) )

// Expected: 1,210
Full Plays = CALCULATE ( [Play Count], FILTER ( FACT_TRACK_PLAYTIME, FACT_TRACK_PLAYTIME[SECONDSPLAYED] = FACT_TRACK_PLAYTIME[TRACKDURATIONSECONDS] ) )

// Expected: 59
Listeners = DISTINCTCOUNT ( FACT_TRACK_PLAYTIME[CUSTOMERKEY] )

// ---- Employee Hire (home table FACT_EMPLOYEE) ----
// Expected: 8   (format: Whole number)
Hires = SUM ( FACT_EMPLOYEE[HIRECOUNT] )

// Expected: 37.9   (37.875; format: Decimal number, 1 decimal place)
Average Age at Hire = AVERAGE ( FACT_EMPLOYEE[AGEATHIRE] )

// Expected: 569,000   (format: Whole number)
Total Starting Salary = SUM ( FACT_EMPLOYEE[STARTINGSALARY] )

// Expected: 71,125   (format: Whole number)
Average Starting Salary = DIVIDE ( [Total Starting Salary], [Hires] )
